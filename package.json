{
  "name": "anyprox",
  "version": "0.1.0",
  "description": "Extensible Cloud Proxy & IP Rotation library for Node.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "anyprox": "./dist/bin/anyprox.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "proxy",
    "ip-rotation",
    "cloudflare-workers",
    "aws-api-gateway",
    "security",
    "scanner",
    "scraping",
    "reverse-proxy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-apigatewayv2": "^3.750.0",
    "@aws-sdk/client-iam": "^3.750.0",
    "@aws-sdk/client-lambda": "^3.750.0",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "undici": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
